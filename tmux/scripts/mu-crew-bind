#!/bin/sh
# Bind mu-crew's keys from @mu_crew_key_*. Run by mu-crew.conf at source time.
# A key set to "none" is left unbound (tmux treats an empty option as unset,
# so "" cannot mean "off" there).
dir=$(cd "$(dirname "$0")" && pwd)

key() { tmux show-option -gqv "@mu_crew_key_$1"; }

# @mu_crew_keys off: unbind what this script binds, so re-sourcing with the
# part off removes it. Only keys still bound to a mu-crew command are touched.
if [ "$(tmux show-option -gqv @mu_crew_keys)" = off ]; then
	for name in pick sidepanel dash workstream; do
		k=$(key "$name")
		[ -n "$k" ] && [ "$k" != none ] || continue
		# `list-keys -T prefix <key>` prints nothing on tmux 3.7; read the table.
		tmux list-keys -T prefix |
			awk -v k="$k" '$3 == "prefix" && $4 == k' |
			grep -qE 'murmur|mu-workstream-pick' &&
			tmux unbind-key -T prefix "$k"
	done
	exit 0
fi

bind() {
	k=$1
	shift
	[ -n "$k" ] && [ "$k" != none ] && tmux bind-key "$@"
}

k=$(key pick)
bind "$k" -N "agent picker (murmur)" "$k" \
	if-shell 'command -v murmur >/dev/null 2>&1' \
	'display-popup -E -w 80% -h 60% "murmur pick"' \
	'display-message "murmur is not installed"'

# run-shell does not export $TMUX_PANE, and murmur sidepanel needs it to find
# the window. #{pane_id} is minted by tmux (%N), so it is safe on a sh line.
k=$(key sidepanel)
bind "$k" -N "agent side panel (murmur)" "$k" \
	if-shell 'command -v murmur >/dev/null 2>&1' \
	'run-shell "TMUX_PANE=#{pane_id} murmur sidepanel"' \
	'display-message "murmur is not installed"'

k=$(key dash)
bind "$k" -N "go to the murmur dash" "$k" \
	if-shell 'command -v murmur >/dev/null 2>&1' \
	'run-shell -b "murmur dash --goto"' \
	'display-message "murmur is not installed"'

k=$(key workstream)
bind "$k" -N "mu workstream <-> workspace picker" "$k" \
	run-shell -b "'$dir/mu-workstream-pick'"
true
